{
  "name": "recurse-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional score tracking for recurse. The game does not need it.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.js",
    "start": "node dist/main.js",
    "migrate": "tsx src/db/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "react": "^19.1.1",
    "react-intl": "^10.1.26"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
