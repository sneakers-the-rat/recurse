# Copy to `.env` and edit. `.env` is ignored by git; this file is not.
#
# Unlike `recurse.yaml`, which is committed because it holds no secrets and the builder refuses
# to run without it, this one names a database and an allowlist that differ per deployment. The
# server refuses to start if anything below is missing or nonsense, rather than falling back to
# a default that would be wrong somewhere it mattered.

# Which origins may call the API, comma-separated, no trailing slash.
#
# This is CORS, so be clear about what it is worth: it stops *a browser* on another site from
# making requests as your logged-in players. It stops nothing else — curl has no origin and
# does not care — so it is hygiene and never a control. The rate limiter and the token are
# what actually hold.
#
# `*` is accepted and means "any origin", which is the right answer for a copy somebody is
# running on their own machine and the wrong one for a deployment.
RECURSE_ORIGINS=http://localhost:5173

# Where the puzzle bank and the graphs come from: a running copy of the site, ending in `data/`.
#
# The server replays rounds against the same bank the client played them on, and fetching it
# from the deployed site is what makes that true by construction rather than by remembering to
# copy a directory. A local build works too: `http://localhost:5173/data/`.
RECURSE_DATA=http://localhost:5173/data/

# The SQLite file. The only copy of everybody's history — back it up.
RECURSE_DB=./recurse.db

RECURSE_PORT=8787

# Set to 1 when something else terminates TLS in front of this (nginx, Caddy, a load balancer).
#
# The rate limiter keys on the caller's address, and behind a proxy every request arrives from
# the proxy — so without this one player's flood is everybody's rate limit. With it, the
# left-most `X-Forwarded-For` entry is used, which is only trustworthy *because* the proxy in
# front is known to set it. Never turn this on when the port is reachable directly: the header
# is then whatever the caller says it is, and the limiter is off.
RECURSE_PROXIED=0
