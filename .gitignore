# What this repo generates, and nothing else.
#
# `.env` is deliberately *not* ignored. It holds no secrets — it is the one place
# every number that shapes the game is written down, and the builder refuses to
# run without it, so a clone that arrived without it could not rebuild the data.

node_modules/
dist/
dist-e2e/

# Rust builder
tools/graphgen/target/

# Playwright: the report and the trace/video scratch dir. The screenshots in
playwright-report/
e2e/.results/
e2e/shots/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Logs and caches
*.log
*.tsbuildinfo
.npm

# The live progress line a long build publishes for the status line to read. Deleted
# when the build finishes; present only while one is running.
.claude-progress


# The cached search result, keyed on everything the search depends on. See bank.rs.
tools/cache/bank-*.tsv

public/data/
