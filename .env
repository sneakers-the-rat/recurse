# ReCurse configuration.
#
# One source of truth for the numbers that shape the game. The builder reads this
# file, then stamps the values it used into public/data/*.json — so the web app
# reads them back out of the data rather than duplicating them here. Change a
# value, re-run `npm run data`, and both sides move together.

# --- what counts as a word -------------------------------------------------
# Shortest word that can be a node in the graph.
RECURSE_MIN_WORD=4
# Shortest run of letters that can be added or removed. Two letters makes the
# graph roughly twice as dense, which means far more routes and far more
# alternatives to weigh.
RECURSE_MIN_SUB=2

# --- dictionaries (SCOWL sizes: 35 small ... 80 comprehensive) -------------
# The graph that ships, and every word a player may guess. Generous on purpose:
# refusing an ordinary word reads as a bug, not a rule.
RECURSE_LEGAL_SCOWL=80
# Only a filter on which puzzles get offered — never on what is legal. A puzzle
# qualifies when its whole best route is made of words at this level.
RECURSE_COMMON_SCOWL=35

# --- the board -------------------------------------------------------------
# How wide a neighbourhood puzzle *selection* measures, as a difficulty statistic
# on the common graph. No longer a ceiling: how much of it gets drawn is the
# client's business, below.
RECURSE_SLACK=6

# What the client actually draws, on the legal graph. Kept separate because the
# two numbers answer different questions — selection asks "is there enough here
# to make a puzzle", drawing asks "how much fits on a phone and still reads".
# Sharing one number made the board a 90-node hairball at 1/5 scale.
#
# Slack is a ceiling: the client widens from 0 while the board stays under
# RECURSE_DRAW_MAX, so it is self-limiting. It matches RECURSE_SLACK on purpose —
# selection guarantees a longer way round exists at that width, and a client
# drawing narrower than the guarantee draws bare lines with nothing to weigh. That
# was tuned to 2 against the legal graph, which is twenty times denser than the
# ordinary-word graph the board is actually drawn from.
RECURSE_DRAW_SLACK=6
RECURSE_DRAW_MAX=30

# --- which puzzles are offered ---------------------------------------------
RECURSE_MIN_PAR=3
RECURSE_MAX_PAR=5
# Draw the two puzzle words from the N most frequent words, so both ends are
# immediately familiar.
RECURSE_ENDPOINT_POOL=4000
# Legal moves that must exist from the opening word, so the first move is a
# choice and not the only option.
RECURSE_MIN_SOURCE_MOVES=2
# Moves in the solution that must add or remove a word from strictly inside
# another. Without this a puzzle can be solved purely by gluing compounds.
RECURSE_MIN_INTERNAL=1
# Prefix/suffix swaps allowed in the solution — splitting apart a compound you
# just made (while + mean = meanwhile, drop while, reach mean) discovers nothing.
RECURSE_MAX_SWAPS=0
# No two words on the solution may be trivial variants of each other (sweet and
# sweets, carry and carries) at any distance apart. Not configurable: a puzzle
# containing both is bookkeeping rather than discovery, so it is always rejected.
# Common-graph nodes that must form a genuine longer way round.
RECURSE_MIN_ALT_NODES=4
# Puzzles that must pass before a word may be an endpoint again.
RECURSE_MIN_GAP=45
# Shuffle seed. Changing this reshuffles which puzzle falls on which day.
RECURSE_SEED=20260725
