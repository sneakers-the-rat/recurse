# ReCurse configuration.
#
# One source of truth for the numbers that shape the game. The builder reads this
# file, then stamps the values it used into public/data/*.json — so the web app
# reads them back out of the data rather than duplicating them here. Change a
# value, re-run `npm run data`, and both sides move together.

# --- what counts as a word -------------------------------------------------
# Shortest word that can be a node in the graph.
RECURSE_MIN_WORD=4
# Shortest run of letters that can be added or removed. Two letters makes the
# graph roughly twice as dense, which means far more routes and far more
# alternatives to weigh.
RECURSE_MIN_SUB=2

# --- dictionaries (SCOWL sizes: 35 small ... 80 comprehensive) -------------
# The graph that ships, and every word a player may guess. Generous on purpose:
# refusing an ordinary word reads as a bug, not a rule.
RECURSE_LEGAL_SCOWL=80
# Only a filter on which puzzles get offered — never on what is legal. A puzzle
# qualifies when its whole best route is made of words at this level.
RECURSE_COMMON_SCOWL=35

# --- the board -------------------------------------------------------------
# How wide a neighbourhood puzzle *selection* measures, as a difficulty statistic
# on the common graph. No longer a ceiling: how much of it gets drawn is the
# client's business, below.
RECURSE_SLACK=6

# --- which puzzles are offered ---------------------------------------------
# Shortest and longest answer the builder looks for. MAX_PAR is a ceiling on the
# *search*, not a filter on taste: every par in this range ships, par is recorded on
# each puzzle, and how par maps to difficulty is the client's business.
RECURSE_MIN_PAR=3
RECURSE_MAX_PAR=10
# Moves out of the opening word that have to lead to the target without coming back
# through it, so the first move is a choice and not the only option.
RECURSE_MIN_SOURCE_MOVES=2

# --- what a puzzle declares it is ------------------------------------------
# A puzzle is a set of shortest ways through (drawn gold), a few longer ways (green),
# and a little of the graph joining them. The builder decides all of it once; the
# client draws what it is given. See tools/graphgen/src/board.rs.
#
# How many longer ways through to declare. Each one is node-disjoint from every way
# already declared, which is what makes it another way to play rather than a detour
# off the last one — in a graph this dense, almost any word beside the answer can
# step off it and back a move later, and hundreds of those are worthless.
RECURSE_ALT_WAYS=4
# How many moves past par one of those may take. Beyond this it joins the same two
# words without being a recognisable answer to the same puzzle.
RECURSE_ALT_SLACK=4
# Consecutive words an alternative must spend away from every route already declared. One
# means a single-word bulge beside the answer counts, which is the same way through with a
# wart on it; two is the least that reads as going somewhere else. The common graph averages
# 2.1 moves per word, so asking for long divergences finds nothing at all.
RECURSE_MIN_DIVERGENCE=2
# How much surrounding graph to declare, as a percentage of the words on a way through.
# Only words joining two or more of them qualify: one drawn neighbour is a spur and says
# nothing, two is a cross-link. Zero draws the ways as bare parallel lines.
#
# Forty-five, because past that the budget buys board size rather than connectedness. Measured
# over four puzzles at 25 / 45 / 70 / 100 percent, every setting gives a board more edges than
# words — which is to say some cross-links — while the words roughly double: `sinking →
# stapled` goes from 45 words to 72 to gain 0.15 edges per word. The goal is *some* rungs, not
# every rung.
#
# What made this work was taking the cheapest rungs first, not raising the budget. Sorted
# alphabetically, a couple of long chains ate the whole allowance and the single-word
# cross-links were never reached.
RECURSE_AROUND_PERCENT=45
# How long a chain running *between* two ways through may be. One finds only single words with
# two neighbours on the board; further reaches find the rungs — the short hops from a word on
# one chain to a word on another — which is what stops a board being two parallel lines joined
# only at the ends.
RECURSE_LINK_REACH=3
# Moves in the solution that must add or remove a word from strictly inside
# another. Without this a puzzle can be solved purely by gluing compounds.
RECURSE_MIN_INTERNAL=1
# Prefix/suffix swaps allowed in the solution — splitting apart a compound you
# just made (while + mean = meanwhile, drop while, reach mean) discovers nothing.
RECURSE_MAX_SWAPS=0
# No two words on the solution may be trivial variants of each other (sweet and
# sweets, carry and carries) at any distance apart. Not configurable: a puzzle
# containing both is bookkeeping rather than discovery, so it is always rejected.
# Common-graph nodes that must form a genuine longer way round.
RECURSE_MIN_ALT_NODES=4
# Puzzles a word waits before it may be an endpoint again, within its own band.
# Ordering only — no puzzle is ever dropped for repeating a word; when the gap cannot be
# honoured the next puzzle is placed anyway. The same day's three puzzles are also kept
# off each other's endpoints where the calendar allows it, on the same terms.
RECURSE_MIN_GAP=45

# --- the three lengths -----------------------------------------------------
# Every day offers one puzzle of each length, and this is where they divide: the last par
# of the short band, then of the medium one. Long is everything above.
#
# 4,6 splits the bank about evenly — 32% short, 38% medium, 30% long — which is the only
# even three-way cut its par distribution has. Moving a cut moves whole pars between
# bands, so the shares move in steps of several points, not smoothly; `npm run data`
# reports what each band came to.
RECURSE_BAND_CUTS=4,6
# Shuffle seed. Changing this reshuffles which puzzle falls on which day.
RECURSE_SEED=20260725
# Day one. The calendar is written as one file per calendar year, so the builder needs the
# date the count starts from — and the client, which used to hard-code it, now reads it out
# of the manifest instead. Two copies of the game's start date is one too many.
#
# Moving it moves every puzzle to a different date. Nothing else depends on it.
RECURSE_EPOCH=2025-01-01

# --- addressing ------------------------------------------------------------
# How many hex digits long a puzzle's blake2s id is, which is the whole of its
# URL: /recurse/2ed944641b7c. Twelve is 48 bits, 281 trillion addresses: over a bank
# of 175,000 that is a 0.00003% chance two puzzles want the same address, and the
# builder refuses to write a bank where that happened rather than shipping two boards
# at one URL. The number has to be read against the size of the bank — eight digits
# is a coin flip at 175,000 puzzles, and was fine at a few thousand.
#
# Not a display width: the length is one of blake2's parameters, so changing this
# gives every puzzle a completely different id rather than a longer one, and every
# link anyone has shared stops resolving. Even numbers only.
RECURSE_ID_CHARS=12
